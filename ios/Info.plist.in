<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key><string>@RETRODOS_DISPLAY_NAME@</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>@RETRODOS_VERSION@</string>
	<key>CFBundleVersion</key><string>@RETRODOS_BUILD@</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>MinimumOSVersion</key><string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>

	<!-- The library IS the user's own files. Both keys, so a game folder can be
	     dropped into the app's folder in Files and opened where it lies. -->
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>

	<!-- A bundle that LINKS a protected API needs the purpose string whether or
	     not it ever calls it, and Apple reports the lack only AFTER a delivery
	     that reported success -- by email, hours later, with CI green. The
	     first upload of 2.0 was rejected exactly this way (ITMS-90683).
	     SDL3 links all three: CoreBluetooth for controllers, and AVCaptureDevice
	     and AVAudioSession for its camera and audio-recording support, which
	     this app does not use but still links. Verified with
	     `nm -u` on the built binary, not assumed. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>DOSDeck uses Bluetooth only to connect game controllers. It collects no data and never scans for anything else.</string>
	<key>NSCameraUsageDescription</key>
	<string>DOSDeck does not use the camera. This entry is required because the SDL library the app is built on links Apple's camera APIs, and iOS asks for the description whether or not they are ever called.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DOSDeck does not record audio. This entry is required because the SDL library the app is built on links Apple's audio-recording APIs, and iOS asks for the description whether or not they are ever called.</string>

	<key>ITSAppUsesNonExemptEncryption</key><false/>

	<!-- Landscape ONLY, matching android:screenOrientation="sensorLandscape".
	     DOS is 320x200 and the shell is a two-pane layout -- a sidebar beside a
	     content list. Portrait was allowed here at first on the theory that the
	     library would be usable one-handed; it is not. The panes keep their
	     widths, so the title collides with the toolbar and every row overlaps
	     its own buttons. The emulator is landscape, the launcher is landscape,
	     and the app should not pretend otherwise. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key><true/>
	<key>UIStatusBarHidden</key><true/>
	<key>UIViewControllerBasedStatusBarAppearance</key><false/>
	<key>UILaunchScreen</key><dict/>
</dict>
</plist>
